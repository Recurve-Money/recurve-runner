# The agent key. Must be an agent on the governor, hold ETH for gas, and hold
# the vault asset for performance fees (settle pulls the fee from this wallet).
PRIVATE_KEY=

# 4663 = Robinhood Chain mainnet (default), 46630 = testnet. Anything else is refused.
RECURVE_CHAIN_ID=4663
# RECURVE_RPC_URL=

# Nothing Recurve is on mainnet yet. Fill from the deploy output
# (recurve-protocol's DEPLOY-MAINNET.md); DEX_QUOTER is Uniswap's official QuoterV2 on
# 4663 (see README). RECURVE_TOKEN is the strategy's basket leg: NVDA,
# 0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC, for the mainnet strategy.
RECURVE_VAULT=
RECURVE_GOVERNOR=
RECURVE_REGISTRY=
RECURVE_STRATEGY=
RECURVE_TOKEN=
DEX_QUOTER=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
RECURVE_DEPLOY_BLOCK=0

# --- Robinhood Chain TESTNET (46630), the testnet fund ---------------------
# TESTNET addresses. The same addresses on mainnet 4663 hold unrelated
# third-party contracts; never copy them up under the mainnet heading.
# RECURVE_CHAIN_ID=46630
# RECURVE_VAULT=0x235d0cE2Ca846495E9B9f18959A41f0625c0443D
# RECURVE_GOVERNOR=0xe0e209799d57E6A95F72BdAe4b148cEf6f03da1a
# RECURVE_REGISTRY=0x26ebF51c3D6967895F83b5C33664d99F1E42c97D
# RECURVE_STRATEGY=0x1D489C89F98d0e87b53941FA4fF9737360BF1b99
# RECURVE_TOKEN=0xf103C471DBCDE5C856559380432eFDC7e59Af9ec
# DEX_QUOTER=0x2691988858D1CA6176D67575Ad4d388BA2664fcA
# RECURVE_DEPLOY_BLOCK=103992284
# ---------------------------------------------------------------------------

# Policy. Defaults shown; see README for what each one trades off.
MIN_TRADE=0.001
RESERVE_BPS=1000
# HOLD_SECONDS=604800
PRICE_TOLERANCE_BPS=300
FORCE_UNWIND=false
PAUSED=false

# Start every new deployment as a dry run and read the log before turning it off.
DRY_RUN=true

RUNNER_INTERVAL_MS=60000
PORT=8080
